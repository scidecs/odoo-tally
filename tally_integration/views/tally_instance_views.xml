<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_instance_list" model="ir.ui.view">
        <field name="name">tally.instance.list</field>
        <field name="model">tally.instance</field>
        <field name="arch" type="xml">
            <list string="Tally Instances">
                <field name="name"/>
                <field name="tally_company"/>
                <field name="tally_host"/>
                <field name="tally_port"/>
                <field name="default_source"/>
                <field name="agent_last_seen"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'online'"
                       decoration-danger="state == 'offline'"
                       decoration-muted="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_tally_instance_form" model="ir.ui.view">
        <field name="name">tally.instance.form</field>
        <field name="model">tally.instance</field>
        <field name="arch" type="xml">
            <form string="Tally Instance">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" icon="fa-plug"/>
                    <button name="action_pull_masters" type="object"
                            string="Pull Masters from Tally" icon="fa-download"
                            invisible="connection_mode != 'direct'"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_sync_now" type="object"
                            string="Sync Now" icon="fa-refresh" class="btn-primary"
                            invisible="connection_mode != 'direct'"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_pull_now" type="object"
                            string="Pull Now (Masters + Vouchers)" icon="fa-cloud-download"
                            invisible="connection_mode != 'direct'"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_reconcile_deletions" type="object"
                            string="Reconcile Deletions" icon="fa-balance-scale"
                            invisible="connection_mode != 'direct'"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_setup_indian_localization" type="object"
                            string="Configure Indian Localization (GST/INR)" icon="fa-flag"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_open_onboarding" type="object"
                            string="Start Onboarding" icon="fa-rocket"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_load_default_entities" type="object"
                            string="Load Default Entities" icon="fa-magic"
                            groups="tally_integration.group_tally_manager"/>
                    <button name="action_generate_token" type="object"
                            string="Generate Agent Token" icon="fa-key"
                            groups="tally_integration.group_tally_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,online,offline"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_mappings" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="mapping_count" widget="statinfo" string="Mappings"/>
                        </button>
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Log Entries"/>
                        </button>
                        <button name="action_view_queue_pending" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="queue_pending" widget="statinfo" string="Pending"/>
                        </button>
                        <button name="action_view_queue_failed" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="queue_failed == 0">
                            <field name="queue_failed" widget="statinfo" string="Failed"/>
                        </button>
                        <button name="action_view_orphans" type="object"
                                class="oe_stat_button" icon="fa-unlink"
                                invisible="orphan_count == 0">
                            <field name="orphan_count" widget="statinfo" string="Orphans"/>
                        </button>
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-check">
                            <field name="synced_today" widget="statinfo" string="Synced Today"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Head Office Tally"/></h1>
                    </div>
                    <group>
                        <group string="Tally Endpoint">
                            <field name="tally_company"/>
                            <field name="tally_host"/>
                            <field name="tally_port"/>
                            <field name="tally_protocol"/>
                            <field name="tally_base_url" placeholder="https://acme-tally.example.com (optional; overrides host/port)"/>
                            <field name="tls_verify" invisible="tally_protocol == 'http' and not tally_base_url"/>
                            <field name="auth_type"/>
                            <field name="auth_username" invisible="auth_type != 'basic'"/>
                            <field name="auth_password" password="True" invisible="auth_type != 'basic'"/>
                            <field name="auth_header_name" invisible="auth_type != 'header'"/>
                            <field name="auth_header_value" password="True" invisible="auth_type != 'header'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Sync Policy">
                            <field name="odoo_edition"/>
                            <field name="odoo_role"/>
                            <field name="connection_mode"/>
                            <field name="tally_inventory"/>
                            <field name="default_source"/>
                            <field name="poll_interval"/>
                            <field name="auto_post"/>
                            <field name="verbose_logging"/>
                            <field name="log_retention_days"/>
                            <field name="direct_auto_pull" invisible="connection_mode != 'direct'"/>
                            <field name="pull_lookback_days" invisible="connection_mode != 'direct'"/>
                            <field name="pull_interval" invisible="connection_mode != 'direct'"/>
                            <field name="last_pull" invisible="connection_mode != 'direct'"/>
                            <field name="use_tdl_delta" invisible="connection_mode != 'direct'"/>
                            <field name="queue_pending"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entities" name="entities">
                            <field name="entity_config_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="entity"/>
                                    <field name="odoo_model_name"/>
                                    <field name="enabled"/>
                                    <field name="direction"/>
                                    <field name="source_of_truth"/>
                                    <field name="last_alterid" readonly="1"/>
                                    <field name="last_sync" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Agent" name="agent">
                            <group>
                                <group string="Pairing">
                                    <field name="agent_token" password="True"
                                           groups="tally_integration.group_tally_manager"/>
                                    <field name="agent_last_seen"/>
                                </group>
                                <group string="How it connects">
                                    <div colspan="2" class="text-muted">
                                        The on-prem Sync Agent authenticates with the token above
                                        and makes outbound-only HTTPS to this Odoo instance. It polls
                                        Tally for AlterID changes and writes Odoo-owned records back
                                        into Tally. No inbound ports are opened on-site.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tally_instance_search" model="ir.ui.view">
        <field name="name">tally.instance.search</field>
        <field name="model">tally.instance</field>
        <field name="arch" type="xml">
            <search string="Tally Instances">
                <field name="name"/>
                <field name="tally_company"/>
                <filter string="Online" name="online" domain="[('state', '=', 'online')]"/>
                <filter string="Offline" name="offline" domain="[('state', '=', 'offline')]"/>
                <group>
                    <filter string="Source of Truth" name="grp_sot"
                            context="{'group_by': 'default_source'}"/>
                    <filter string="Status" name="grp_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tally_instance_kanban" model="ir.ui.view">
        <field name="name">tally.instance.kanban</field>
        <field name="model">tally.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-2">
                            <field name="name" class="fw-bold fs-5 me-auto"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'online'"
                                   decoration-danger="state == 'offline'"
                                   decoration-secondary="state == 'draft'"/>
                        </div>
                        <div class="text-muted mb-2">
                            <field name="tally_company" class="fw-semibold"/>
                            <span class="mx-1">•</span>
                            <field name="connection_mode"/>
                            <span class="mx-1">•</span>
                            <field name="odoo_role"/>
                        </div>
                        <div class="row g-2 text-center my-2">
                            <div class="col-4">
                                <div class="border rounded p-2 bg-light">
                                    <div class="text-muted small">Pending</div>
                                    <div class="fw-bold fs-5"><field name="queue_pending"/></div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-2 bg-light">
                                    <div class="text-danger small">Failed</div>
                                    <div class="fw-bold fs-5 text-danger"><field name="queue_failed"/></div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-2 bg-light">
                                    <div class="text-warning small">Orphans</div>
                                    <div class="fw-bold fs-5 text-warning"><field name="orphan_count"/></div>
                                </div>
                            </div>
                        </div>
                        <footer class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                            <div class="small text-muted">
                                <field name="synced_today"/> synced today
                            </div>
                            <div class="d-flex gap-1">
                                <button name="action_sync_now" type="object" string="Sync Now"
                                        class="btn btn-sm btn-primary"
                                        invisible="connection_mode != 'direct'"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tally_instance" model="ir.actions.act_window">
        <field name="name">Tally Instances</field>
        <field name="res_model">tally.instance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_tally_instance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your first Tally instance</p>
            <p>Define the Tally endpoint, choose the source of truth, load the entities to sync,
               and pair the on-prem Sync Agent.</p>
        </field>
    </record>
</odoo>
