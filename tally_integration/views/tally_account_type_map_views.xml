<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_account_type_map_list" model="ir.ui.view">
        <field name="name">tally.account.type.map.list</field>
        <field name="model">tally.account.type.map</field>
        <field name="arch" type="xml">
            <list string="Account Type Mapping" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="tally_group"/>
                <field name="account_type"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_tally_account_type_map" model="ir.actions.act_window">
        <field name="name">Account Type Mapping</field>
        <field name="res_model">tally.account.type.map</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map Tally groups to Odoo account types</p>
            <p>Used when importing Tally's chart of accounts. Seeded with defaults for Tally's
               reserved groups; adjust to your CoA.</p>
        </field>
    </record>
</odoo>
