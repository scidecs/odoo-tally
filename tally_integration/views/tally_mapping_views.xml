<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_mapping_list" model="ir.ui.view">
        <field name="name">tally.mapping.list</field>
        <field name="model">tally.mapping</field>
        <field name="arch" type="xml">
            <list string="Mappings">
                <field name="instance_id"/>
                <field name="entity"/>
                <field name="tally_guid"/>
                <field name="odoo_model_name"/>
                <field name="odoo_res_id"/>
                <field name="last_origin"/>
                <field name="last_sync"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'conflict'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_tally_mapping_form" model="ir.ui.view">
        <field name="name">tally.mapping.form</field>
        <field name="model">tally.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapping">
                <header>
                    <button name="action_open_odoo_record" type="object"
                            string="Open Odoo Record" icon="fa-external-link"/>
                </header>
                <sheet>
                    <group>
                        <group string="Tally">
                            <field name="instance_id"/>
                            <field name="entity"/>
                            <field name="tally_guid"/>
                            <field name="tally_masterid"/>
                        </group>
                        <group string="Odoo">
                            <field name="odoo_model_name"/>
                            <field name="odoo_res_id"/>
                            <field name="last_origin"/>
                            <field name="content_hash"/>
                            <field name="last_sync"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tally_mapping_search" model="ir.ui.view">
        <field name="name">tally.mapping.search</field>
        <field name="model">tally.mapping</field>
        <field name="arch" type="xml">
            <search string="Mappings">
                <field name="tally_guid"/>
                <field name="odoo_model_name"/>
                <field name="instance_id"/>
                <filter string="Conflicts" name="conflicts" domain="[('state', '=', 'conflict')]"/>
                <filter string="Errors" name="errors" domain="[('state', '=', 'error')]"/>
                <group>
                    <filter string="Instance" name="grp_instance" context="{'group_by': 'instance_id'}"/>
                    <filter string="Entity" name="grp_entity" context="{'group_by': 'entity'}"/>
                    <filter string="State" name="grp_state" context="{'group_by': 'state'}"/>
                    <filter string="Last Origin" name="grp_origin" context="{'group_by': 'last_origin'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tally_mapping" model="ir.actions.act_window">
        <field name="name">Mappings</field>
        <field name="res_model">tally.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tally_mapping_search"/>
    </record>
</odoo>
