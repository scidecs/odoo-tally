<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_tally" model="ir.module.category">
            <field name="name">Tally Integration</field>
            <field name="description">Access rights for the Tally Prime integration.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_tally_user" model="res.groups">
            <field name="name">Tally / User</field>
            <field name="category_id" ref="module_category_tally"/>
            <field name="comment">Read access to Tally sync configuration, mappings and logs.</field>
        </record>

        <record id="group_tally_manager" model="res.groups">
            <field name="name">Tally / Administrator</field>
            <field name="category_id" ref="module_category_tally"/>
            <field name="implied_ids" eval="[(4, ref('group_tally_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Full control of connections, entity configuration and the agent.</field>
        </record>

    </data>
</odoo>
