        </record>
        <record id="atm_sundry_creditors" model="tally.account.type.map">
            <field name="tally_group">Sundry Creditors</field><field name="account_type">liability_payable</field>
        </record>
        <record id="atm_duties_taxes" model="tally.account.type.map">
            <field name="tally_group">Duties &amp; Taxes</field><field name="account_type">liability_current</field>
