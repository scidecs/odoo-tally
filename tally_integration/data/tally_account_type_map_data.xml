            <field name="tally_group">Capital Account</field><field name="account_type">equity</field>
        </record>
        <record id="atm_loans_liability" model="tally.account.type.map">
            <field name="tally_group">Loans (Liability)</field><field name="account_type">liability_non_current</field>
        </record>
        <record id="atm_current_liabilities" model="tally.account.type.map">
